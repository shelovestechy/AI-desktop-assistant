QMainWindow {
    background: #050a12;
}

QLabel {
    color: #bdefff;
    font-family: "Segoe UI";
}

QLabel#assistantTitle {
    font-size: 42px;
    font-weight: 600;
    letter-spacing: 8px;
}

QLabel#clock {
    font-size: 20px;
}

QLabel#status {
    font-size: 16px;
    color: #62d8ff;
    padding: 8px;
}

QLabel#systemStatus {
    font-size: 13px;
    color: #83cce5;
}

QTextBrowser#conversation {
    color: #d9f7ff;
    background: #07111b;
    border: 1px solid #1f536c;
    border-radius: 10px;
    padding: 14px;
    font-family: "Segoe UI";
    font-size: 14px;
    selection-background-color: #1b6f91;
}

QLineEdit#commandInput {
    color: #d9f7ff;
    background: #071722;
    border: 1px solid #28627d;
    border-radius: 8px;
    padding: 12px 14px;
    font-family: "Segoe UI";
    font-size: 14px;
    selection-background-color: #1b6f91;
}

QLineEdit#commandInput:focus {
    border: 1px solid #62d8ff;
}

QPushButton {
    color: #bdefff;
    background: #0c2638;
    border: 1px solid #62d8ff;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 14px;
}

QPushButton:hover {
    background: #123b54;
}

QScrollBar:vertical {
    background: #07111b;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #28627d;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
